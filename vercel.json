{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "source": "/api/(.*)", "dest": "backend/api/index.js" },
    { "handle": "filesystem" },
    { "source": "/(.*)", "dest": "/index.html" }
  ]
}
